# cp .env.example .env — never commit the real .env.
#
# The org's signing key is NOT set here. It is a mounted secret FILE, because environment variables are
# readable via `docker inspect`, via /proc/<pid>/environ, and they leak into logs and crash dumps:
#
#     printf '%s' '<64-hex-char seed>' > deploy/signer-seed.txt && chmod 600 deploy/signer-seed.txt
#
# (Override the path with SIGNER_SEED_FILE. The file is gitignored. Keep a backup — it IS the org's authority.)

# Protects the admin routes (SR8 pause/resume, retry, pubkey) AND /metrics, which share the public health
# port. If empty, those routes return 403 — safe, but SR8 pause will NOT be available in an incident.
ADMIN_API_KEY=

# Optional: shared secret so the wallet can authenticate the policy engine's decisions (policy.auth: hmac).
POLICY_HMAC_SECRET=
